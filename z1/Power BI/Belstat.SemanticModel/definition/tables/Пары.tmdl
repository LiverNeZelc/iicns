table Пары
	lineageTag: 1d6a7fa8-8e1b-418c-bbdb-44586eb11904

	measure 'Показатель выбран' = SELECTEDVALUE('Пары'[Показатель],"Черные металлы")
		lineageTag: abf6d1de-62c6-4043-beda-9271d6f86d73

	measure 'Единица выбранного' = VAR s=[Показатель выбран] RETURN CALCULATE(MAX('Пары'[Единица]),'Пары'[Показатель]=s)
		lineageTag: 9c737ea9-c74e-428e-8572-6a1e8f7dc8cc

	measure 'Значение пары' = VAR s=[Показатель выбран] RETURN CALCULATE(SUM('Пары'[Значение]),'Пары'[Показатель]=s)
		formatString: #,0.0
