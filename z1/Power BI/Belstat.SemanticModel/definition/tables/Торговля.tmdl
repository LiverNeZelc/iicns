table Торговля
	lineageTag: fa3c010d-06c2-405d-bd84-9f057afb596c

	measure 'Число рядов' = DISTINCTCOUNT('Торговля'[Ряд])
		formatString: 0
		lineageTag: 6ac691d1-e105-4a37-96c3-818aafd450e9

	measure 'Число аномалий' = CALCULATE(COUNTROWS('Торговля'),'Торговля'[Аномалия]<>"Норма")+0
		formatString: 0
		lineageTag: 3327bbb9-a50b-4cc1-86af-187939045e40

	measure 'Индекс 2000=100 (медиана)' = MEDIAN('Торговля'[Индекс 2000=100])
		formatString: 0
		lineageTag: d3b95250-fe09-442f-807a-a1d537e0e088

	measure 'Значение 2000' = CALCULATE(SUM('Торговля'[Значение]),'Торговля'[Год]=2000)
		formatString: #,0.0
		lineageTag: 456f5fc8-f859-475a-8c98-f180cd7bc29b

	measure 'Значение 2021' = CALCULATE(SUM('Торговля'[Значение]),'Торговля'[Год]=2021)
		formatString: #,0.0
		lineageTag: 13a1b12a-8897-4a16-ace2-7bb576f312a2

	measure 'Рост 2000–2021, %' = DIVIDE([Значение 2021],[Значение 2000])-1
		formatString: 0%
		lineageTag: fee2cfdc-9fc2-42b0-b7c5-97486d4505bb

	measure 'CAGR 2000–2021' = VAR a=[Значение 2000] VAR b=[Значение 2021] RETURN IF(a>0&&b>0,(b/a)^(1/21)-1)
		formatString: 0.0%
		lineageTag: 2d549e41-a696-4c47-8e76-ad7c29010772

	measure 'Ряд выбран' = SELECTEDVALUE('Торговля'[Ряд],"Экспорт · Черные металлы")
		lineageTag: 6843d3df-dc9c-49c0-ad9b-62fe0b65d419

	measure 'Единица выбранного ряда' = VAR s=[Ряд выбран] RETURN CALCULATE(MAX('Торговля'[Единица]),'Торговля'[Ряд]=s)
		lineageTag: f833d7cc-4b42-4a92-9d1a-6b23a7e27085

	measure 'Значение (ряд)' = VAR s=[Ряд выбран] RETURN CALCULATE(SUM('Торговля'[Значение]),'Торговля'[Ряд]=s)
		formatString: #,0.0
		lineageTag: fdc5851d-2d1e-4830-bfa2-fcc4da5a37c9

	measure 'Изменение к пред. году (ряд)' = VAR s=[Ряд выбран] RETURN CALCULATE(AVERAGE('Торговля'[YoY, %]),'Торговля'[Ряд]=s)
		formatString: 0.0%
		lineageTag: 02b90842-34d2-484e-bdfe-41d23858a00f

	measure 'Значение 2000 (ряд)' = CALCULATE([Значение (ряд)],'Торговля'[Год]=2000)
		formatString: #,0.0
		lineageTag: 23307662-6d0d-4741-b33c-b8b698b5fa24

	measure 'Значение 2021 (ряд)' = CALCULATE([Значение (ряд)],'Торговля'[Год]=2021)
		formatString: #,0.0
		lineageTag: 97a02b47-f92e-4ae9-9bba-ea19afa95119

	measure 'CAGR (ряд)' = VAR a=[Значение 2000 (ряд)] VAR b=[Значение 2021 (ряд)] RETURN IF(a>0&&b>0,(b/a)^(1/21)-1)
		formatString: 0.0%
		lineageTag: d7dc841e-c1be-459e-b9c6-86a8e2b49178

